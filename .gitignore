# Build output
/bin/
/dist/
*.exe

# Go
*.test
*.prof
coverage.out

# Frontend
node_modules/
web/.vite/

# Built interface. The directory itself is kept, with a placeholder, so that
# `go build` works for somebody who has not run the frontend build: go:embed
# fails outright on a directory that does not exist.
web/dist/*
!web/dist/.gitkeep

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite

# Secrets and local config
.env
.env.*
!.env.example
*.local

# Development queue output
dev/out/

# Runtime state
/run/
setup-token

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript incremental build state, regenerated by every build.
*.tsbuildinfo
